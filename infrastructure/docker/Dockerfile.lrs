# Production Dockerfile for LRS xAPI Ingestion Engine on Google Cloud Run
FROM node:20-alpine

WORKDIR /app

# Copy application files
COPY mock-lrs/package.json ./
RUN npm install --omit=dev 2>/dev/null || true

COPY mock-lrs/ ./

# Cloud Run dynamic port binding
ENV PORT=8080
EXPOSE 8080

CMD ["node", "server.js"]
