# Production Dockerfile for HIS Clinical Portal & Media Wrappers on Google Cloud Run
FROM nginx:alpine

# Copy custom nginx configuration for Cloud Run (port 8080)
COPY infrastructure/docker/nginx-cloudrun.conf /etc/nginx/conf.d/default.conf

# Copy frontend assets
COPY portal /usr/share/nginx/html/portal
COPY media-wrappers /usr/share/nginx/html/media-wrappers
COPY mock-nexus-api /usr/share/nginx/html/mock-nexus-api

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
